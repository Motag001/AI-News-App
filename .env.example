# Copy this file to .env and edit values for your local environment.
DATABASE_PATH=./data/ai_news.db
APP_BASE_URL=http://localhost:8000
# Set to false to stop the background fetcher (e.g. when offline).
INGEST_ENABLED=true
# Stories older than this many days are deleted automatically.
RETENTION_DAYS=30

# AI Pulse. Leave OPENAI_API_KEY empty to publish plain extractive editions (no AI text, general-knowledge challenge).
# Put the real key in your host's secret store or a local .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PULSE_MAX_OUTPUT_TOKENS=900
PULSE_DAILY_ATTEMPT_LIMIT=3
PULSE_GENERATE_ON_REQUEST=true
# Set a long random value to enable POST /api/v1/pulse/refresh (operator-only editorial refresh).
PULSE_ADMIN_TOKEN=
